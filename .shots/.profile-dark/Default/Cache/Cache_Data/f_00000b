); text-transform: uppercase; font-weight: 700; }\n.footer button {\n  display: block; background: none; border: 0; color: var(--muted);\n  padding: 11px 0; text-align: left; font-size: 15.5px; line-height: 1.4;\n  transition: color 0.18s ease;\n}\n.footer button:hover { color: var(--green); }\n.footer p { line-height: 1.95; color: var(--muted); font-size: 15px; max-width: 30ch; }\n/* Contact links were falling back to the browser's default blue. */\n.footer a { color: var(--muted); text-decoration: none; }\n.footer a:hover { color: var(--green); }\n\n.foot-brand { display: flex; flex-direction: column; align-items: flex-start; }\n.foot-lockup { display: flex; align-items: center; gap: var(--sp-3); margin-bottom: var(--sp-1); }\n.foot-mark {\n  display: inline-flex; align-items: center; justify-content: center;\n  width: 46px; height: 46px; border-radius: 13px; flex: none;\n  background: var(--green); box-shadow: 0 6px 20px rgba(34, 233, 72, 0.36);\n}\n.foot-lockup .wordmark { font-size: 26px; }\n.foot-tag {\n  font-size: 10.5px; font-weight: 700; letter-spacing: 2.8px;\n  text-transform: uppercase; color: var(--accent-ink); margin: var(--sp-2) 0 20px;\n}\n\n.pill-row { display: flex; gap: var(--in-2); flex-wrap: wrap; margin-top: var(--in-5); }\n.pill-row span {\n  display: inline-flex; align-items: center; gap: var(--sp-2);\n  border: 1px solid var(--border); border-radius: 999px;\n  padding: var(--in-2) var(--in-4); font-size: 13px; color: var(--muted); font-weight: 600;\n  background: var(--panel-2);\n}\n.pill-row span:hover { color: var(--green); border-color: var(--border-strong); }\n.foot-base {\n  display: flex; align-items: center; justify-content: space-between;\n  gap: var(--sp-3); flex-wrap: wrap;\n  max-width: var(--shell); margin: 40px auto 0; padding-top: 40px;\n  border-top: 1px solid var(--border); color: var(--muted); font-size: 14px;\n}\n.foot-made { display: inline-flex; align-items: center; gap: var(--in-1); }\n.foot-made svg { color: var(--green); }\n@media (max-width: 640px) {\n  .foot-base { flex-direction: column; text-align: center; }\n}\n\n/* ------------------------------------------------------------ chat/cookies */\n\n/* Circular floating button, bottom-right, with a soft accent bloom. */\n.chat-fab {\n  position: fixed; right: 24px; bottom: 26px;\n  width: 54px; height: 54px; padding: 0;\n  display: flex; align-items: center; justify-content: center;\n  border-radius: 50%; background: var(--green); color: var(--on-green);\n  border: 0; z-index: 30; cursor: pointer;\n  box-shadow: 0 10px 34px rgba(34, 233, 72, 0.42), 0 0 0 6px rgba(34, 233, 72, 0.12);\n  transition: transform 0.2s ease, box-shadow 0.2s ease, background 0.2s ease;\n}\n.chat-fab:hover {\n  transform: scale(1.07);\n  box-shadow: 0 14px 42px rgba(34, 233, 72, 0.55), 0 0 0 9px rgba(34, 233, 72, 0.14);\n}\n\n.chat-box {\n  position: fixed; right: 24px; bottom: 96px; width: 372px;\n  max-width: calc(100vw - 32px); max-height: min(680px, calc(100vh - 140px));\n  display: flex; flex-direction: column; overflow: hidden;\n  background: var(--panel); border: 1px solid var(--border-strong);\n  border-radius: 20px; z-index: 30; box-shadow: 0 30px 70px rgba(0, 0, 0, 0.55);\n}\n\n/* Accent header band with the assistant identity. */\n.chat-head {\n  display: flex; align-items: center; gap: var(--sp-3);\n  padding: var(--sp-4) var(--sp-4) var(--in-4);\n  background: linear-gradient(120deg, var(--green) 0%, var(--green-dark) 100%);\n  color: var(--on-green);\n  flex: none;\n}\n.chat-head .chat-avatar { background: rgba(255, 255, 255, 0.22); color: #fff; border-color: transparent; }\n.chat-head .chat-id { display: flex; flex-direction: column; gap: 3px; flex: 1; min-width: 0; }\n.chat-head .chat-id strong { font-size: 15.5px; font-weight: 800; letter-spacing: -0.01em; }\n.chat-head .chat-id small { display: flex; align-items: center; gap: var(--in-1); font-size: 11.5px; opacity: 0.9; }\n.chat-head .chat-id i { width: 7px; height: 7px; border-radius: