const __vite__css = "/* ==========================================================================\n   Poppins, self-hosted (latin subset only, ~38 KB total).\n   Geometric sans matching the reference. Swap the family below to change it.\n   ========================================================================== */\n\n@font-face {\n  font-family: \"Poppins\";\n  font-style: normal;\n  font-weight: 400;\n  font-display: swap;\n  src: url(\"/fonts/poppins-400.woff2\") format(\"woff2\");\n}\n@font-face {\n  font-family: \"Poppins\";\n  font-style: normal;\n  font-weight: 500;\n  font-display: swap;\n  src: url(\"/fonts/poppins-500.woff2\") format(\"woff2\");\n}\n@font-face {\n  font-family: \"Poppins\";\n  font-style: normal;\n  font-weight: 600;\n  font-display: swap;\n  src: url(\"/fonts/poppins-600.woff2\") format(\"woff2\");\n}\n@font-face {\n  font-family: \"Poppins\";\n  font-style: normal;\n  font-weight: 700;\n  font-display: swap;\n  src: url(\"/fonts/poppins-700.woff2\") format(\"woff2\");\n}\n@font-face {\n  font-family: \"Poppins\";\n  font-style: normal;\n  font-weight: 800;\n  font-display: swap;\n  src: url(\"/fonts/poppins-800.woff2\") format(\"woff2\");\n}\n\n/* ==========================================================================\n   Linkodra PH - design tokens\n   Every colour in the app resolves through these variables, so the light/dark\n   switch is a single attribute change on <html> and nothing else needs to know.\n   ========================================================================== */\n\n/* Spacing scale. Every gap, section rhythm and card padding draws from these so\n   the layout stays on one rhythm. Prefer these over one-off pixel values.\n\n   Two tiers. --sp is the macro scale for page and section rhythm. --in is the\n   minor scale for component interiors, which need finer steps than the macro\n   scale provides - it jumps 4 to 8 and 16 to 24, leaving no room for the 6,10,\n   14 and 18 that padding inside buttons, chips and cards actually calls for.\n   Both carry their real measured value, so tokenising changes no spacing. */\n:root {\n  --sp-1: 4px;\n  --sp-2: 8px;\n  --sp-3: 12px;\n  --sp-4: 16px;\n  --sp-5: 24px;\n  --sp-6: 32px;\n  --sp-7: 48px;\n  --sp-8: 64px;\n  --sp-9: 80px;\n  --sp-10: 96px;\n  --sp-11: 112px;\n  --sp-12: 128px;\n\n  --in-1: 6px;\n  --in-2: 10px;\n  --in-3: 14px;\n  --in-4: 18px;\n  --in-5: 22px;\n\n  --gap-grid: var(--sp-5);\n  --gap-stack: var(--sp-4);\n  --radius-card: 18px;\n  --radius-input: 10px;\n  --radius-pill: 999px;\n}\n\n:root,\n:root[data-theme=\"dark\"] {\n  --bg: #080d0a;\n  --bg-soft: #0c130e;\n  --panel: #0f1711;\n  --panel-2: #141e17;\n  --panel-3: #1b271d;\n  --border: rgba(34, 233, 72, 0.18);\n  --border-strong: rgba(34, 233, 72, 0.4);\n  --green: #22e948;\n  --green-dark: #16c939;\n  --green-soft: rgba(34, 233, 72, 0.13);\n  --accent-soft: rgba(34, 233, 72, 0.08);\n  --accent-ink: #a3ffb8;\n  --glow: 0 0 60px rgba(34, 233, 72, 0.22);\n  --ring: 0 0 0 1px var(--green);\n  --on-green: #04140a;\n  --text: #ffffff;\n  --muted: #9db3a3;\n  --faint: #6f8577;\n  --input-bg: #070c08;\n  --danger: #ff6b6b;\n  --warn: #ffc14d;\n  --shadow: 0 24px 60px rgba(0, 0, 0, 0.5);\n  --card-ink: #ffffff;\n  --card-ink-dim: rgba(255, 255, 255, 0.68);\n  --nav-bg: rgba(10, 16, 12, 0.82);\n  --aura-a: rgba(34, 233, 72, 0.055);\n  --aura-b: rgba(22, 201, 57, 0.04);\n  --aura-c: rgba(9, 40, 18, 0.5);\n  /* Section rhythm and container width draw from the spacing scale below. */\n  --band: 110px;\n  /* Measured off the reference: ~76px headline in a 1440px container. */\n  --headline: clamp(38px, 3.6vw, 72px);\n  /* Container width. Tightened from 1440px so it actually binds on common\n     laptop widths; at 1440 the grid ran fluid and the footer columns sprawled. */\n  --shell: 1280px;\n}\n\n:root[data-theme=\"light\"] {\n  --bg: #f4f7f4;\n  --bg-soft: #eaf1ea;\n  --panel: #ffffff;\n  --panel-2: #f3f8f3;\n  --panel-3: #e6efe6;\n  --border: rgba(22, 201, 57, 0.28);\n  --border-strong: rgba(22, 201, 57, 0.55);\n  --green: #12a830;\n  --green-dark: #0e8d27;\n  --green-soft: rgba(22, 201, 57, 0.12);\n  --accent-soft: rgba(22, 201, 57, 0.06);\n  --accent-ink: #0a7d22;\n  --glow: 0 0 50px rgba(22, 201, 57, 0.16);\n  --ring: 0 0 0 1px var(--green);\n  --on-green: #ffffff;\n  --text: #0a120c;\n  --muted: #4f6156;\n  --faint: #7b8d82;\n  --input-bg: #ffffff;\n  --danger: #d63a3a;\n  --warn: #b8730a;\n  --shadow: 0 24px 60px rgba(16, 40, 24, 0.12);\n  --card-ink: #ffffff;\n  --card-ink-dim: rgba(255, 255, 255, 0.75);\n  --nav-bg: rgba(246, 248, 246, 0.85);\n  --aura-a: rgba(22, 201, 57, 0.07);\n  --aura-b: rgba(34, 233, 72, 0.05);\n  --aura-c: rgba(226, 240, 228, 0.75);\n  --band: 92px;\n}\n\n/* ========================================================================== */\n\n* { box-sizing: border-box; }\n\nhtml { scroll-behavior: smooth; }\n\nbody {\n  margin: 0;\n  /* The hero rule is 100vw, which includes the scrollbar gutter. Clip rather\n     than hide, so no horizontal scrollbar appears and no scroll container is\n     created. */\n  overflow-x: clip;\n  background-color: var(--bg);\n  /* Two very soft brand-tinted blooms keep the dark theme from reading as\n     flat black, without lifting it enough to compete with the copy. */\n  background-image:\n    radial-gradient(1100px 620px at 12% -8%, var(--aura-a), transparent 62%),\n    radial-gradient(900px 560px at 88% 4%, var(--aura-b), transparent 60%),\n    radial-gradient(1000px 700px at 50% 108%, var(--aura-c), transparent 64%);\n  background-repeat: no-repeat;\n  background-attachment: fixed;\n  color: var(--text);\n  font-family: \"Poppins\", system-ui, \"Segoe UI\", Roboto, Arial, sans-serif;\n  transition: background-color 0.25s ease, color 0.25s ease;\n}\n\na, button { font: inherit; }\nbutton { cursor: pointer; }\nimg { max-width: 100%; }\n\n:focus-visible {\n  outline: 2px solid var(--green);\n  outline-offset: 2px;\n  border-radius: 6px;\n}\n\n.app { min-height: 100vh; }\n\nmain { max-width: var(--shell); margin: 0 auto; padding: var(--sp-11) var(--sp-5) var(--sp-8); }\n@media (max-width: 900px) {\n  main { padding: var(--sp-9) var(--sp-4) var(--sp-7); }\n}\n\nh1, h2, h3, h4 { line-height: 1.18; }\n\n/* --------------------------------------------------------------- buttons */\n\n.btn {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  gap: var(--sp-2);\n  border-radius: 999px;\n  padding: var(--in-2) var(--in-4);\n  border: 1px solid var(--border);\n  background: transparent;\n  color: var(--text);\n  font-weight: 700;\n  line-height: 1.2;\n  transition: background 0.18s ease, color 0.18s ease, border-color 0.18s ease, transform 0.18s ease;\n}\n.btn:hover { border-color: var(--border-strong); }\n.btn:active { transform: translateY(1px); }\n.btn[disabled] { opacity: 0.45; cursor: not-allowed; transform: none; }\n.btn.primary { background: var(--green); color: var(--on-green); border-color: transparent; }\n.btn.primary:hover { background: var(--green-dark); }\n.btn.ghost { background: transparent; color: var(--text); border-color: var(--border); }\n.btn.soft { background: var(--green-soft); color: var(--green); border-color: transparent; }\n.btn.soft:hover { background: var(--border-strong); color: var(--text); }\n.btn.danger { background: transparent; color: var(--danger); border-color: var(--danger); }\n.btn.full { width: 100%; margin-top: var(--in-2); }\n.btn.big { font-size: 17px; padding: 13px 26px; }\n.btn.sm { padding: var(--in-1) var(--sp-3); font-size: 13px; }\n.btn.icon { padding: 9px; width: 38px; height: 38px; border-radius: 10px; }\n\n.link {\n  background: none;\n  border: 0;\n  color: var(--green);\n  margin-top: var(--in-2);\n  padding: 0;\n  font-weight: 600;\n}\n\n/* ------------------------------------------------------------------- nav */\n\n.nav {\n  position: fixed;\n  top: 0; left: 0; right: 0;\n  z-index: 20;\n  /* Three zones so the links sit centred in the bar rather than trailing the\n     logo, which left a large void on wide screens. */\n  display: grid;\n  grid-template-columns: 1fr auto 1fr;\n  align-items: center;\n  gap: var(--in-3);\n  /* Full-bleed background and rule, with the content held to the shell width\n     via padding. Capping the bar itself left a visible rectangle that stopped\n     short of the screen edges. */\n  padding: var(--sp-3) max(28px, calc((100% - var(--shell)) / 2));\n  /* Transparent at rest so the page gradient runs through the bar unbroken;\n     a surface and rule appear only once content scrolls underneath. */\n  background: transparent;\n  border-bottom: 1px solid transparent;\n  transition: background 0.25s ease, border-color 0.25s ease;\n}\n.nav.is-scrolled {\n  background: var(--nav-bg);\n  backdrop-filter: blur(14px) saturate(140%);\n  border-bottom-color: var(--border);\n}\n/* The mark sits in a rounded badge with an accent bloom, as in the reference. */\n.nav-logo {\n  background: none; border: 0; padding: 0;\n  display: inline-flex; align-items: center; gap: var(--in-2);\n  flex: none; line-height: 0;\n}\n.nav-mark {\n  display: inline-flex; align-items: center; justify-content: center;\n  width: 38px; height: 38px; border-radius: 11px;\n  background: var(--green); color: var(--on-green);\n  box-shadow: 0 6px 22px rgba(34, 233, 72, 0.4);\n  flex: none; overflow: hidden; line-height: 0;\n}\n.nav-mark svg { display: block; flex: none; }\n\n.nav-links { display: flex; gap: 2px; justify-self: center; }\n.nav-links button {\n  position: relative;\n  background: none; border: 0; color: var(--muted);\n  padding: 9px var(--sp-3) 11px; border-radius: 8px;\n  font-size: 15px; font-weight: 500; letter-spacing: 0.01em;\n  transition: color 0.2s ease;\n}\n/* Underline rule that wipes in from the centre, as in the reference. */\n.nav-links button::after {\n  content: \"\";\n  position: absolute; left: 12px; right: 12px; bottom: 4px;\n  height: 2px; border-radius: 2px;\n  background: var(--accent-ink);\n  transform: scaleX(0);\n  transition: transform 0.22s ease;\n}\n.nav-links button:hover { color: var(--text); }\n.nav-links button:hover::after,\n.nav-links button.active::after { transform: scaleX(1); }\n.nav-links button.active { color: var(--text); font-weight: 600; }\n\n.nav-cta { justify-self: end; display: flex; gap: var(--sp-3); align-items: center; }\n\n/* Login is a plain text link with a person mark, not a pill button. */\n.nav-login {\n  display: inline-flex; align-items: center; gap: 7px;\n  background: none; border: 0; color: var(--muted);\n  font-size: 15px; font-weight: 500; padding: var(--sp-2) var(--sp-1);\n  transition: color 0.18s ease;\n}\n.nav-login:hover { color: var(--text); }\n.nav-login svg { opacity: 0.8; }\n\n/* The theme switch is a bordered square, matching the reference control. */\n.theme-toggle {\n  width: 40px; height: 40px; border-radius: 10px;\n  display: inline-flex; align-items: center; justify-content: center;\n  background: transparent; border: 1px solid var(--border);\n  color: var(--muted); flex: none;\n  transition: border-color 0.18s ease, color 0.18s ease;\n}\n.theme-toggle:hover { border-color: var(--border-strong); color: var(--text); }\n\n.nav-cta-btn { padding: var(--sp-3) var(--sp-5); font-size: 15.5px; font-weight: 700; box-shadow: 0 6px 24px rgba(34, 233, 72, 0.3); }\n.nav-cta-btn:hover { box-shadow: 0 10px 30px rgba(34, 233, 72, 0.4); }\n\n.nav-tools { display: none; gap: var(--sp-2); align-items: center; }\n\n/* Below the breakpoint the bar collapses to a single row: logo, then menu. */\n@media (max-width: 900px) {\n  .nav { display: flex; }\n  .nav-links, .nav-cta { display: none; }\n  /* The toggle lives in .nav-tools and is otherwise inside the desktop-only\n     action group, so it has to be surfaced here or mobile has no way to\n     switch theme at all. */\n  .nav-tools { display: flex; margin-left: auto; }\n  .menu-btn { margin-left: var(--sp-1); }\n}\n\n/* Fixed attachment is costly on touch devices, so the aura scrolls with the\n   page there instead. */\n@media (max-width: 720px) {\n  body { background-attachment: scroll; }\n}\n\n.desktop { display: flex; }\n.menu-btn {\n  display: none; background: none; border: 1px solid var(--border);\n  color: var(--text); border-radius: 8px; padding: var(--in-1) var(--in-2); margin-left: auto;\n}\n.mobile-menu {\n  position: absolute; top: 60px; right: 12px;\n  background: var(--panel); border: 1px solid var(--border);\n  border-radius: 14px; display: flex; flex-direction: column;\n  min-width: 240px; padding: var(--sp-2); box-shadow: var(--shadow); z-index: 30;\n}\n.mobile-menu button {\n  background: none; border: 0; color: var(--text);\n  text-align: left; padding: 11px var(--sp-3); border-radius: 8px; font-weight: 600;\n}\n.mobile-menu button:hover { background: var(--green-soft); }\n.mobile-menu .mm-cta { margin-top: var(--in-1); justify-content: center; }\n\n@media (max-width: 900px) {\n  .desktop { display: none; }\n  .menu-btn { display: block; }\n}\n\n/* ------------------------------------------------------------------ wordmark */\n\n.wordmark { font-weight: 700; font-size: 21px; letter-spacing: -0.02em; color: var(--text); }\n.wordmark .o-split { color: var(--green); }\n.wordmark .ph { font-size: 11px; color: var(--green); margin-left: var(--sp-1); }\n\n/* --------------------------------------------------------------- sections */\n\n/* ==========================================================================\n   Landing page\n   Two-column hero, banded sections with generous vertical rhythm, and cards\n   that read as a set rather than a grid.\n   ========================================================================== */\n\n/* --------------------------------------------------------- category chips */\n\n.chips { display: flex; flex-wrap: wrap; gap: 9px; margin: var(--sp-1) 0 var(--in-5); }\n.chip {\n  display: inline-flex; align-items: center; gap: var(--sp-2);\n  border: 1px solid var(--border); background: var(--panel);\n  color: var(--text); border-radius: 999px;\n  padding: var(--sp-2) 15px; font-size: 13.5px; font-weight: 600;\n  transition: border-color 0.18s ease, background 0.18s ease, color 0.18s ease;\n}\n.chip svg { color: var(--muted); flex: none; }\n.chip small { color: var(--faint); font-size: 11.5px; font-weight: 700; }\n.chip:hover { border-color: var(--border-strong); }\n.chip.sel { background: var(--green); border-color: transparent; color: var(--on-green); }\n.chip.sel svg, .chip.sel small { color: inherit; opacity: 0.85; }\n\n.sort-row { display: flex; align-items: center; gap: var(--sp-3); margin: 0 0 var(--in-5); flex-wrap: wrap; }\n.sort-row select { width: auto; padding: 9px var(--in-3); }\n\n/* ----------------------------------------------------- help article rows */\n\n.article-list { display: flex; flex-direction: column; gap: var(--in-2); }\n.article {\n  background: var(--panel); border: 1px solid var(--border);\n  border-radius: 14px; overflow: hidden;\n  transition: border-color 0.2s ease;\n}\n.article.is-open { border-color: var(--border-strong); }\n.article-head {\n  display: flex; align-items: center; gap: var(--sp-4); width: 100%;\n  background: none; border: 0; color: var(--text);\n  padding: var(--sp-4) var(--in-4); text-align: left;\n}\n.article-head:hover { background: var(--panel-2); }\n.article-text { display: flex; flex-direction: column; gap: 3px; flex: 1; min-width: 0; }\n.article-text strong { font-size: 15.5px; font-weight: 700; line-height: 1.35; }\n.article-text small { color: var(--muted); font-size: 13.5px; line-height: 1.5; }\n.article-text em {\n  font-style: normal; font-size: 10.5px; font-weight: 800;\n  letter-spacing: 1.2px; text-transform: uppercase; color: var(--green); margin-top: var(--sp-1);\n}\n.article-body { padding: 0 var(--in-4) var(--in-4) 68px; margin: 0; line-height: 1.7; font-size: 14.5px; }\n\n.chev { color: var(--muted); flex: none; transition: transform 0.25s ease; }\n.chev.open { transform: rotate(180deg); color: var(--green); }\n@media (max-width: 640px) {\n  .article-body { padding-left: var(--in-4); }\n}\n\n/* ------------------------------------------------------------------- FAQ */\n\n.faq-row { border-bottom: 1px solid var(--border); }\n.faq-row > button {\n  display: flex; align-items: center; justify-content: space-between; gap: var(--sp-4);\n  width: 100%; background: none; border: 0; color: var(--text);\n  padding: 20px var(--sp-1); text-align: left; font-size: 16px; font-weight: 600;\n}\n.faq-row > button:hover { color: var(--green); }\n.faq-row p { margin: 0 0 20px; padding-right: 40px; line-height: 1.7; }\n\n/* Plus that rotates a quarter turn to read as a minus when open. */\n.faq-sign { position: relative; width: 18px; height: 18px; flex: none; }\n.faq-sign::before, .faq-sign::after {\n  content: \"\"; position: absolute; inset: 50% 0 auto 0;\n  height: 2px; background: var(--green); border-radius: 2px;\n  transition: transform 0.25s ease;\n}\n.faq-sign::after { transform: rotate(90deg); }\n.faq-row.is-open .faq-sign::after { transform: rotate(0deg); }\n\n/* --------------------------------------------------------------- contact */\n\n.contact-split {\n  display: grid; grid-template-columns: 1fr 1fr;\n  gap: 44px; align-items: start; margin-top: var(--sp-2);\n}\n@media (max-width: 860px) { .contact-split { grid-template-columns: 1fr; gap: 30px; } }\n\n.contact-info h2 { font-size: 24px; margin: 0 0 var(--sp-5); }\n.contact-row { display: flex; gap: var(--in-3); align-items: flex-start; margin-bottom: var(--in-5); }\n.contact-row > div { min-width: 0; }\n.contact-row em {\n  display: block; font-style: normal; font-size: 10.5px; font-weight: 800;\n  letter-spacing: 1.4px; text-transform: uppercase; color: var(--green); margin-bottom: 5px;\n}\n.contact-row a, .contact-row p { display: block; margin: 0; line-height: 1.6; }\n.contact-row a:hover { color: var(--green); }\n\n/* ========================================================================== */\n\n.band { padding: var(--band) 0; }\n.band-tight { padding: calc(var(--band) * 0.55) 0; }\n@media (max-width: 900px) {\n  .band { padding: var(--sp-8) 0; }\n  .band-tight { padding: var(--sp-7) 0; }\n}\n\n.band-head { text-align: center; max-width: 640px; margin: 0 auto 56px; }\n.band-head h2 { margin: 0 0 var(--sp-4); font-size: clamp(28px, 3vw, 46px); letter-spacing: -0.015em; }\n.band-head p { color: var(--muted); margin: 0; line-height: 1.7; font-size: 16.5px; }\n\n/* ------------------------------------------------------------------- hero */\n\n/* Two columns: a fixed-width copy track and a flexible stage for the card,\n   matching the reference proportions rather than splitting evenly.\n   min-height holds the hero to a full screen so the next band starts below\n   the fold instead of peeking in. */\n.hero-split {\n  position: relative;\n  display: grid;\n  grid-template-columns: minmax(0, 560px) minmax(0, 1fr);\n  gap: var(--sp-7);\n  align-items: center;\n  min-height: calc(100vh - 240px);\n  padding: 0 0 20px;\n}\n/* Rule across the base of the hero. Drawn on a 100vw pseudo-element so it\n   spans the viewport like the nav rule, rather than stopping at the shell. */\n.hero-split::after {\n  content: \"\";\n  position: absolute;\n  left: 50%;\n  bottom: 0;\n  transform: translateX(-50%);\n  width: 100vw;\n  height: 1px;\n  background: var(--border);\n}\n@media (max-width: 1040px) {\n  .hero-split { grid-template-columns: 1fr; gap: 44px; min-height: 0; }\n  .hero-copy { max-width: 100%; }\n}\n\n.hero-copy {\n  max-width: 560px;\n  /* Nudged off the container edge so the text block is not flush left. */\n  margin-left: 92px;\n}\n@media (max-width: 1040px) { .hero-copy { margin-left: 0; } }\n\n/* Two-tone headline: first line inherits, the rest takes the accent. */\n.display {\n  font-size: var(--headline);\n  line-height: 1.05;\n  letter-spacing: -0.02em;\n  font-weight: 800;\n  margin: 0 0 var(--sp-5);\n}\n.display .accent { color: var(--accent-ink); }\n.display .line { display: block; }\n\n.hero-lede { font-size: 17px; line-height: 1.75; color: var(--muted); max-width: 500px; margin: 0 0 var(--sp-3); }\n.hero-lede a { color: var(--accent-ink); text-decoration: underline; text-underline-offset: 3px; text-decoration-thickness: 1px; text-decoration-color: var(--green); }\n.hero-lede a:hover { color: var(--green); }\n\n/* The accent half of the headline reads as a lighter tint of the brand colour,\n   the way the reference uses lavender rather than its full-strength purple. */\n.accent-ink { color: var(--accent-ink); }\n\n.cta-row { display: flex; gap: var(--in-3); flex-wrap: wrap; margin-top: var(--sp-6); }\n.cta-primary {\n  display: inline-flex; align-items: center; gap: var(--in-2);\n  background: var(--green); color: var(--on-green);\n  border: 0; border-radius: 999px; padding: 15px 28px;\n  font-weight: 700; font-size: 15.5px;\n  box-shadow: 0 8px 30px rgba(34, 233, 72, 0.28);\n  transition: transform 0.2s ease, box-shadow 0.2s ease, background 0.2s ease;\n}\n.cta-primary:hover { background: var(--green-dark); transform: translateY(-2px); box-shadow: 0 14px 38px rgba(34, 233, 72, 0.36); }\n.cta-primary svg { transition: transform 0.2s ease; }\n.cta-primary:hover svg { transform: translateX(3px); }\n.cta-ghost {\n  display: inline-flex; align-items: center;\n  background: transparent; color: var(--text);\n  border: 1px solid var(--border-strong); border-radius: 999px; padding: 15px 28px;\n  font-weight: 700; font-size: 15.5px; transition: border-color 0.2s ease, background 0.2s ease;\n}\n.cta-ghost:hover { border-color: var(--green); background: var(--accent-soft); }\n\n/* 3D presentation card.\n   The float animation lives on a wrapper so it cannot collide with the hover\n   transform on the card itself: a paused CSS animation still applies its\n   transform, and animations outrank normal declarations, so keeping both on\n   one element meant hover never took effect. */\n.card-stage { display: flex; justify-content: center; }\n.card-stage-float {\n  position: relative;\n  perspective: 1200px;\n  animation: cardFloat 7s ease-in-out infinite;\n}\n.card-stage-inner {\n  position: relative;\n  transform: rotateY(-12deg) rotateX(5deg) rotateZ(7deg);\n  transform-style: preserve-3d;\n  /* Longer, softer curve: the rotation has real distance to travel, so a short\n     expo-out reads as a snap. filter trails slightly behind the geometry. */\n  transition:\n    transform 0.75s cubic-bezier(0.16, 1, 0.3, 1),\n    filter 0.6s ease;\n  filter: saturate(0.92);\n  cursor: pointer;\n}\n.card-stage-inner::after {\n  content: \"\";\n  position: absolute; inset: 8% -12% -14% 12%;\n  background: radial-gradient(closest-side, var(--green-soft), transparent 72%);\n  filter: blur(28px); z-index: -1;\n  /* Hidden at rest so it cannot read as a green rim around the card. */\n  opacity: 0;\n  transition: opacity 0.75s ease;\n}\n/* Hover flattens the perspective, lifts the card and lets it fill the frame. */\n.card-stage:hover .card-stage-inner {\n  transform: rotateY(0deg) rotateX(0deg) rotateZ(0deg) translateY(-12px) scale(1.06);\n  filter: saturate(1.08);\n}\n.card-stage:hover .card-stage-inner::after { opacity: 0.85; }\n\n@keyframes cardFloat {\n  0%, 100% { transform: translateY(0); }\n  50% { transform: translateY(-14px); }\n}\n@media (prefers-reduced-motion: reduce) {\n  .card-stage-float { animation: none; }\n}\n\n/* --------------------------------------------------------------- icon card */\n\n.icon-badge {\n  width: 58px; height: 58px; border-radius: 50%;\n  display: flex; align-items: center; justify-content: center;\n  background: var(--accent-soft); border: 1px solid var(--border);\n  color: var(--green); margin-bottom: var(--in-5);\n}\n.icon-badge.sm { width: 34px; height: 34px; margin-bottom: 0; }\n\n.feature-card { padding: 38px 34px; }\n.feature-card h3 { font-size: 19px; margin-bottom: var(--sp-3); letter-spacing: -0.01em; }\n.feature-card p { margin: 0; line-height: 1.7; font-size: 15px; }\n\n/* --------------------------------------------------------------- tier card */\n\n.tier-set {\n  display: grid; grid-template-columns: repeat(3, 1fr);\n  gap: 26px; align-items: start;\n}\n@media (max-width: 940px) {\n  .tier-set { grid-template-columns: 1fr; max-width: 440px; margin: 0 auto; gap: 30px; }\n  .tier-card.is-featured { transform: none; }\n}\n\n.tier-card {\n  position: relative;\n  background: var(--panel); border: 1px solid var(--border);\n  border-radius: 20px; padding: 36px var(--sp-6) 34px;\n  display: flex; flex-direction: column;\n  transition: transform 0.25s ease, border-color 0.25s ease, box-shadow 0.25s ease;\n}\n.tier-card:hover { transform: translateY(-4px); border-color: var(--border-strong); }\n.tier-card.is-featured {\n  transform: translateY(-16px);\n  border-color: var(--green);\n  box-shadow: var(--glow), 0 30px 70px rgba(0, 0, 0, 0.45);\n}\n.tier-card.is-featured:hover { transform: translateY(-20px); }\n\n/* The badge straddles the top border rather than floating inside the card. */\n/* The flag is a corner tab rather than a pill straddling the border. */\n.tier-flag {\n  position: absolute; top: 0; right: 0;\n  background: var(--green); color: var(--on-green);\n  font-size: 10px; font-weight: 800; letter-spacing: 0.9px;\n  padding: 9px var(--in-4);\n  border-radius: 0 20px 0 16px;\n  white-space: nowrap;\n}\n.tier-name {\n  font-size: 26px; font-weight: 700; letter-spacing: -0.02em;\n  margin: 0 0 var(--in-2); color: var(--text);\n}\n.tier-card.is-featured .tier-name { color: var(--green); }\n.tier-price {\n  font-size: 42px; font-weight: 800; letter-spacing: -0.025em;\n  line-height: 1; margin: 20px 0 0;\n}\n.tier-price .cur { font-size: 26px; vertical-align: 7px; margin-right: 1px; }\n.tier-price .per { font-size: 14px; font-weight: 500; color: var(--muted); letter-spacing: 0; margin-left: var(--in-1); }\n.tier-desc { color: var(--muted); font-size: 14px; line-height: 1.6; margin: 0; min-height: 44px; }\n\n/* Feature rows carry their own icon so positive and negative read differently. */\n.tier-features { list-style: none; padding: 0; margin: var(--in-5) 0 28px; flex: 1; }\n.tier-features li {\n  display: flex; align-items: center; gap: var(--sp-3);\n  padding: var(--sp-2) 0; font-size: 14.5px; line-height: 1.45; color: var(--text);\n}\n.tier-features li svg { flex: none; color: var(--green); }\n.tier-features li.off { color: var(--faint); }\n.tier-features li.off svg { color: var(--faint); }\n.tier-card.is-featured .tier-features li svg { color: var(--green); }\n\n.tier-card .btn { width: 100%; justify-content: center; }\n\n.carousel-dots { display: none; justify-content: center; gap: var(--sp-2); margin-top: 28px; }\n.carousel-dots span { width: 7px; height: 7px; border-radius: 50%; background: var(--border-strong); }\n@media (max-width: 940px) { .carousel-dots { display: flex; } }\n\n/* ------------------------------------------------------------- testimonial */\n\n.testimonial { text-align: center; max-width: 860px; margin: 0 auto; }\n.testimonial .quote-mark { color: var(--green); opacity: 0.55; margin-bottom: 26px; }\n.testimonial blockquote {\n  font-size: clamp(20px, 2vw, 30px); line-height: 1.55;\n  letter-spacing: -0.015em; margin: 0 0 40px; font-weight: 500;\n}\n.testimonial blockquote .accent { color: var(--accent-ink); font-weight: 700; }\n\n.person-line { display: flex; align-items: center; gap: var(--in-3); justify-content: center; text-align: left; }\n.person-line .avatar { width: 60px; height: 60px; font-size: 18px; flex: none; }\n.person-line .who strong { display: block; font-size: 16px; }\n.person-line .who span { color: var(--muted); font-size: 14px; }\n\n/* ---------------------------------------------------------------- final CTA */\n\n.final-cta { text-align: center; }\n.final-cta h2 {\n  font-size: clamp(30px, 3.6vw, 54px); line-height: 1.12;\n  letter-spacing: -0.02em; margin: 0 0 var(--in-5);\n}\n.final-cta p { color: var(--muted); max-width: 620px; margin: 0 auto; line-height: 1.7; font-size: 16.5px; }\n.final-cta .cta-row { justify-content: center; margin-top: 38px; }\n\n/* ========================================================================== */\n\n.section { padding: var(--sp-3) 0; }\n.section.narrow { max-width: 620px; margin: 0 auto; }\n.section.wide { max-width: 1000px; }\n\n.hero { text-align: center; padding: 36px 0 var(--sp-3); }\n.hero-badge {\n  display: inline-flex; align-items: center; gap: 9px;\n  border: 1px solid var(--border); color: var(--muted);\n  border-radius: 999px; padding: var(--sp-2) var(--sp-4); font-size: 11.5px;\n  letter-spacing: 1.5px; text-transform: uppercase; margin: 0 0 26px; font-weight: 600;\n}\n.hero-badge::before {\n  content: \"\"; width: 6px; height: 6px; border-radius: 50%;\n  background: var(--green); flex: none;\n}\n.hero h1 { font-size: clamp(34px, 6vw, 64px); margin: var(--sp-3) 0 var(--in-3); line-height: 1.08; }\n.section h1 { font-size: clamp(28px, 4vw, 44px); margin: var(--sp-3) 0; }\n.section h2 { margin: 40px 0 var(--in-3); font-size: clamp(22px, 3vw, 32px); }\n.section h3 { margin: 0 0 var(--sp-2); }\n.green { color: var(--green); }\n.lede { color: var(--muted); max-width: 660px; margin: 0 auto; line-height: 1.65; }\n.muted { color: var(--muted); line-height: 1.6; }\n.small { font-size: 13px; }\n.center { text-align: center; }\n.mantra {\n  margin: var(--in-5) 0 var(--in-2); display: flex; gap: var(--in-5); row-gap: var(--in-2);\n  flex-wrap: wrap; justify-content: center; letter-spacing: 5px;\n  font-size: 14px; color: var(--text); font-weight: 700;\n}\n.btn-row { display: flex; gap: var(--sp-3); justify-content: center; margin: var(--in-5) 0; flex-wrap: wrap; }\n.btn-row.left { justify-content: flex-start; }\n\n.eyebrow {\n  font-size: 11px; letter-spacing: 2.4px; text-transform: uppercase;\n  color: var(--green); font-weight: 800;\n}\n\n/* ----------------------------------------------------------------- panels */\n\n.panel {\n  background: var(--panel);\n  border: 1px solid var(--border);\n  border-radius: 16px;\n  padding: 20px;\n}\n.panel.tight { padding: var(--in-3) var(--sp-4); }\n.panel.success { border-color: var(--green); background: var(--green-soft); }\n.panel.price { position: relative; padding-top: 26px; }\n.panel.stat { display: flex; flex-direction: column; gap: var(--sp-1); }\n.panel p:first-child { margin-top: 0; }\n.panel ul { padding: 0; margin: var(--sp-3) 0; color: var(--muted); }\n.panel li { margin: 7px 0; list-style: none; padding-left: 0; }\n.ticks li { padding-left: var(--sp-5); position: relative; }\n.ticks li::before {\n  content: \"\";\n  position: absolute; left: 2px; top: 0.5em;\n  width: 10px; height: 5px;\n  border-left: 2px solid var(--green);\n  border-bottom: 2px solid var(--green);\n  transform: rotate(-45deg);\n}\n.ticks li.is-locked { color: var(--faint); }\n.ticks li.is-locked::before {\n  border: 0;\n  top: 0.72em;\n  width: 10px; height: 2px;\n  background: var(--faint);\n  transform: none;\n}\n\n.flag {\n  position: absolute; top: -11px; left: 50%; transform: translateX(-50%);\n  background: var(--green); color: var(--on-green); font-size: 10px; font-weight: 800;\n  padding: var(--sp-1) var(--sp-3); border-radius: 999px; white-space: nowrap; letter-spacing: 0.5px;\n}\n.amount { font-size: 32px; font-weight: 800; color: var(--green); margin: var(--sp-2) 0; }\n.amount small { font-size: 14px; color: var(--muted); font-weight: 600; }\n\n.cards3 { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--gap-grid); margin: var(--sp-4) 0; }\n.cards2 { display: grid; grid-template-columns: repeat(2, 1fr); gap: var(--gap-grid); margin: var(--sp-4) 0; }\n.cards4 { display: grid; grid-template-columns: repeat(4, 1fr); gap: var(--gap-grid); margin: var(--sp-4) 0; }\n/* Tablet drops to two columns before the single-column mobile stack. */\n@media (max-width: 1080px) {\n  .cards4 { grid-template-columns: repeat(2, 1fr); }\n}\n@media (max-width: 900px) {\n  .cards3, .cards2, .cards4 { grid-template-columns: 1fr; gap: var(--sp-4); }\n}\n\n.grid-side { display: grid; grid-template-columns: 1fr 340px; gap: var(--sp-4); align-items: start; }\n@media (max-width: 900px) { .grid-side { grid-template-columns: 1fr; } }\n\n/* ------------------------------------------------------------------ forms */\n\nlabel { display: block; font-size: 12px; color: var(--muted); margin: var(--sp-3) 0 5px; font-weight: 600; }\n\ninput, textarea, select {\n  width: 100%;\n  background: var(--input-bg);\n  border: 1px solid var(--border);\n  color: var(--text);\n  border-radius: var(--radius-input);\n  padding: var(--sp-3) var(--sp-3);\n  font: inherit;\n  transition: border-color 0.18s ease, box-shadow 0.18s ease;\n}\ninput:focus, textarea:focus, select:focus {\n  outline: none;\n  border-color: var(--green);\n  box-shadow: 0 0 0 3px var(--green-soft);\n}\ninput::placeholder, textarea::placeholder { color: var(--faint); }\nselect:disabled { opacity: 0.5; cursor: not-allowed; }\ntextarea { resize: vertical; }\n\n.field-row { display: grid; grid-template-columns: 1fr 1fr; gap: var(--sp-3); }\n@media (max-width: 640px) { .field-row { grid-template-columns: 1fr; } }\n\n.field-note { font-size: 12px; color: var(--faint); margin-top: 5px; }\n.field-error { font-size: 12px; color: var(--danger); margin-top: 5px; }\n\n.search { max-width: 460px; }\n\n.check { display: flex; gap: var(--sp-2); align-items: center; margin: var(--sp-3) 0; }\n.check input { width: auto; }\n.check label { margin: 0; }\n\n.seg { display: flex; gap: var(--sp-2); flex-wrap: wrap; margin: var(--in-2) 0; }\n.seg.wrap { gap: var(--in-1); }\n.seg button {\n  background: transparent; border: 1px solid var(--border); color: var(--text);\n  border-radius: 999px; padding: var(--sp-2) var(--in-3); font-weight: 600;\n  transition: background 0.16s ease, color 0.16s ease;\n}\n.seg button:hover:not(.sel) { border-color: var(--border-strong); }\n.seg button.sel { background: var(--green); color: var(--on-green); font-weight: 800; border-color: transparent; }\n.seg button:disabled { opacity: 0.4; cursor: not-allowed; }\n\n.chips { display: flex; gap: var(--sp-2); flex-wrap: wrap; }\n\n/* --------------------------------------------------------------- elements */\n\n.quote { text-align: center; }\n.quote blockquote { font-size: 20px; color: var(--text); line-height: 1.6; margin: 0 0 var(--sp-3); }\n\n.steps { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--in-3); }\n@media (max-width: 900px) { .steps { grid-template-columns: 1fr; } }\n.step-n { color: var(--green); font-weight: 800; letter-spacing: 1px; }\n.step h3 { margin-top: var(--in-1); }\n\n.table-wrap { overflow: auto; border: 1px solid var(--border); border-radius: 12px; margin: var(--in-4) 0; }\ntable { width: 100%; border-collapse: collapse; min-width: 620px; }\nth, td { padding: 11px var(--sp-3); border-bottom: 1px solid var(--border); text-align: left; }\nth { color: var(--green); font-weight: 700; }\ntbody tr:last-child td { border-bottom: 0; }\n\n.faq details {\n  background: var(--panel); border: 1px solid var(--border);\n  border-radius: 12px; margin: var(--in-2) 0; padding: var(--in-3) var(--sp-4);\n}\n.faq summary { cursor: pointer; font-weight: 700; line-height: 1.5; }\n.faq details p { color: var(--muted); line-height: 1.7; margin: var(--sp-3) 0 0; }\n.faq details small { color: var(--faint); }\n\n.banner {\n  border: 1px solid var(--border); background: var(--green-soft);\n  border-radius: 14px; padding: var(--in-3) var(--sp-4); display: flex;\n  gap: var(--sp-3); align-items: center; flex-wrap: wrap; margin: var(--sp-4) 0;\n}\n.banner.warn { background: rgba(255, 193, 77, 0.12); border-color: var(--warn); }\n\n.locked { position: relative; opacity: 0.72; }\n.locked-note {\n  display: flex; align-items: center; gap: var(--in-2); flex-wrap: wrap;\n  border: 1px dashed var(--border-strong); border-radius: 12px;\n  padding: var(--sp-3) var(--in-3); margin-top: var(--sp-3); font-size: 13px; color: var(--muted);\n}\n\n.empty {\n  text-align: center; padding: 34px var(--sp-4); color: var(--muted);\n  border: 1px dashed var(--border); border-radius: 14px;\n}\n\n.stat b { font-size: 26px; display: block; color: var(--text); }\n.stat small { color: var(--muted); font-weight: 600; }\n.bar { height: 8px; background: var(--panel-3); border-radius: 99px; margin-top: var(--in-2); overflow: hidden; }\n.bar i { display: block; height: 100%; background: var(--green); border-radius: 99px; }\n\n.err { color: var(--danger); }\n.ok { color: var(--green); }\n.mono { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; }\n\ncode {\n  background: var(--panel-3); border: 1px solid var(--border);\n  padding: var(--sp-1) var(--sp-2); border-radius: 8px; color: var(--green);\n  font-size: 13px; word-break: break-all;\n}\n\n/* ------------------------------------------------------------ card preview */\n\n.card-preview-zone {\n  display: flex; flex-direction: column; align-items: center;\n  gap: var(--sp-3); min-width: 0; text-align: center;\n}\n.card-preview-zone small { display: block; max-width: 360px; line-height: 1.55; color: var(--muted); }\n\n.nfc-card {\n  display: block; width: 100%; max-width: 380px; aspect-ratio: 1.6;\n  background: #0b0e0b; border: 1px solid var(--border); border-radius: 18px;\n  color: #fff; padding: var(--in-4); text-align: left;\n  box-shadow: var(--shadow);\n  transition: transform 0.3s ease;\n}\n.nfc-card:hover { transform: translateY(-2px); }\n.nfc-card.portrait { aspect-ratio: 0.63; max-width: 306px; margin: 0 auto; }\n.nfc-card.design-neon { background: #071007; }\n.nfc-card.design-solid { background: #0a1a0e; }\n\n/* Soft mesh of green blooms over near-black, so the face reads as printed\n   gradient stock rather than a flat CSS fill. */\n.nfc-card.design-gradient {\n  background:\n    radial-gradient(90% 62% at 16% 8%, rgba(190, 255, 150, 0.55), transparent 55%),\n    radial-gradient(70% 48% at 88% 26%, rgba(34, 233, 72, 0.4), transparent 60%),\n    radial-gradient(120% 70% at 40% 108%, rgba(9, 70, 24, 0.9), transparent 62%),\n    linear-gradient(158deg, #0f4520 0%, #071a0d 58%, #050705 100%);\n  /* No stroke at all: the gradient carries the card edge on its own. */\n  border: 0;\n}\n.nfc-card.glossy { position: relative; overflow: hidden; }\n.nfc-card.glossy::after {\n  content: \"\"; position: absolute; inset: 0;\n  background: linear-gradient(118deg, rgba(255, 255, 255, 0.18) 0%, rgba(255, 255, 255, 0) 34%);\n  pointer-events: none;\n}\n.nfc-card.matte { box-shadow: 0 10px 30px rgba(0, 0, 0, 0.4); }\n\n/* Card face type: logo lockup top-left, contactless centred, details anchored bottom. */\n.nfc-wordmark { display: flex; align-items: center; gap: var(--sp-3); }\n.nfc-wordmark > span {\n  display: flex; flex-direction: column; line-height: 1;\n  font-size: 19px; font-weight: 800; letter-spacing: 0.5px; color: #fff;\n}\n.nfc-wordmark em {\n  font-style: normal; font-size: 8.5px; font-weight: 600;\n  letter-spacing: 2.4px; text-transform: uppercase;\n  color: rgba(255, 255, 255, 0.72); margin-top: var(--in-1);\n}\n.mono-sm { font-variant-numeric: tabular-nums; letter-spacing: 0.01em; }\n\n.nfc-row {\n  display: flex; justify-content: space-between; align-items: center;\n  gap: var(--in-2); font-size: 10px; color: #d8ffe2; font-weight: 800; letter-spacing: 1.6px;\n}\n.nfc-badge { color: #22e948; }\n.nfc-mid {\n  display: flex; gap: var(--in-3); align-items: center;\n  margin: var(--in-4) 0; min-height: 78px;\n}\n.nfc-card.portrait .nfc-mid { flex-direction: column; align-items: center; justify-content: center; }\n.card-holder { margin-top: auto; }\n.card-name { font-size: 20px; font-weight: 800; line-height: 1.25; }\n.nfc-card.portrait .card-name { font-size: 22px; }\n.card-sub { color: var(--card-ink-dim); font-size: 13px; margin-top: var(--sp-1); line-height: 1.45; }\n.card-foot {\n  display: flex; justify-content: space-between; align-items: center;\n  gap: var(--sp-3); flex-wrap: wrap; border-top: 1px solid rgba(255, 255, 255, 0.18);\n  padding-top: var(--sp-3); font-size: 12px;\n}\n.nfc-card.design-gradient .card-foot { border-top-color: rgba(0, 0, 0, 0.2); }\n\n.qr-box {\n  border: 1px dashed #22e948; border-radius: 8px; padding: 7px;\n  text-align: center; color: #22e948; font-weight: 800; font-size: 11px; letter-spacing: 1px;\n}\n.fake-qr {\n  width: 108px; height: 108px; margin: var(--sp-3) auto; background: #fff;\n  border-radius: 8px; border: 4px solid #22e948;\n}\n\n/* -------------------------------------------------------------- phone mock */\n\n.phone-mock {\n  background: var(--panel-2); border: 1px solid var(--border);\n  border-radius: 26px; padding: 20px var(--sp-4); text-align: center; min-width: 0;\n}\n.phone-url {\n  background: var(--panel-3); border-radius: 10px; padding: 9px;\n  font-size: 12px; color: var(--green); margin-bottom: var(--in-3);\n  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;\n}\n.phone-name { display: block; font-size: 18px; margin: var(--in-2) 0 2px; }\n.phone-sub { display: block; line-height: 1.55; color: var(--muted); font-size: 13px; margin-bottom: var(--sp-3); }\n.avatar {\n  width: 64px; height: 64px; border-radius: 50%; background: var(--green);\n  color: var(--on-green); font-weight: 800;\n  display: flex; align-items: center; justify-content: center; margin: 0 auto;\n}\n.avatar.big { width: 88px; height: 88px; font-size: 26px; }\n.socials { display: flex; gap: var(--sp-2); justify-content: center; margin: var(--sp-3) 0; flex-wrap: wrap; }\n.socials span {\n  min-width: 36px; height: 36px; padding: 0 9px; border-radius: 9px;\n  background: var(--green-soft); border: 1px solid var(--border);\n  display: flex; align-items: center; justify-content: center;\n  font-size: 12px; font-weight: 700; color: var(--text);\n}\n.script { font-family: Georgia, serif; color: var(--green); display: block; margin-top: var(--in-2); }\n\n/* ------------------------------------------------------------------- order */\n\n.wizard { display: flex; gap: var(--sp-2); list-style: none; padding: 0; margin: var(--in-4) 0 var(--in-5); flex-wrap: wrap; }\n.wizard li button {\n  background: var(--panel); border: 1px solid var(--border);\n  color: var(--muted); border-radius: 999px; padding: var(--sp-2) var(--in-3); font-weight: 600;\n}\n.wizard li.active button { color: var(--on-green); background: var(--green); font-weight: 800; border-color: transparent; }\n.wizard li.done button { color: var(--green); border-color: var(--green); }\n\n.order-grid { display: grid; grid-template-columns: 270px minmax(0, 1fr) 310px; gap: var(--sp-4); align-items: start; }\n@media (max-width: 1040px) {\n  .order-grid { grid-template-columns: 1fr; max-width: 560px; margin: 0 auto; }\n}\n\n.tier-pick { display: flex; flex-direction: column; gap: var(--in-2); }\n.tier-pick button {\n  background: var(--panel); border: 1px solid var(--border); border-radius: 12px;\n  color: var(--text); padding: var(--in-3); text-align: left;\n  display: flex; flex-direction: column; gap: 3px; position: relative;\n  transition: border-color 0.18s ease;\n}\n.tier-pick button:hover { border-color: var(--border-strong); }\n.tier-pick button.sel { border-color: var(--green); box-shadow: 0 0 0 1px var(--green); }\n.tier-pick button b { font-size: 16px; }\n.tier-pick button span { color: var(--green); font-weight: 800; }\n.tier-pick button small { color: var(--muted); }\n.tier-pick .flag { top: -9px; font-size: 9px; }\n\n.design-pick { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--in-2); }\n.design-pick button {\n  background: var(--panel); border: 1px solid var(--border); border-radius: 12px;\n  color: var(--text); padding: var(--sp-2); font-size: 12px; font-weight: 600;\n  display: flex; flex-direction: column; gap: var(--sp-2); align-items: center;\n}\n.design-pick button.sel { border-color: var(--green); box-shadow: 0 0 0 1px var(--green); }\n.design-swatch {\n  width: 100%; height: 52px; border-radius: 8px; border: 1px solid var(--border);\n  display: flex; align-items: center; justify-content: center;\n  font-size: 10px; font-weight: 800; letter-spacing: 1px; color: #fff;\n}\n.design-swatch.swatch-minimalist { background: #0b0e0b; color: #22e948; }\n.design-swatch.swatch-neon { background: #071007; color: #22e948; }\n.design-swatch.swatch-gradient {\n  background: linear-gradient(150deg, #16c939 0%, #0b4a1c 46%, #050705 100%);\n  color: #fff;\n}\n\n.totals { margin: var(--in-3) 0; border-top: 1px solid var(--border); padding-top: var(--in-2); }\n.totals div { display: flex; justify-content: space-between; margin: var(--in-1) 0; }\n.totals .grand { font-weight: 800; color: var(--green); font-size: 18px; }\n\n.summary-row {\n  display: flex; justify-content: space-between; gap: var(--sp-3);\n  padding: 9px 0; border-bottom: 1px solid var(--border); font-size: 14px;\n}\n.summary-row:last-child { border-bottom: 0; }\n.summary-row span:first-child { color: var(--muted); }\n\n.pay-pick { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--in-2); }\n@media (max-width: 640px) { .pay-pick { grid-template-columns: 1fr; } }\n.pay-pick button {\n  background: var(--panel); border: 1px solid var(--border); border-radius: 12px;\n  color: var(--text); padding: var(--in-3) var(--in-2); font-weight: 700; display: flex;\n  flex-direction: column; align-items: center; gap: var(--in-1);\n}\n.pay-pick button.sel { border-color: var(--green); box-shadow: 0 0 0 1px var(--green); }\n.pay-pick small { color: var(--muted); font-weight: 500; font-size: 11px; }\n\n/* --------------------------------------------------------- auth/dashboard */\n\n/* --------------------------------------------------------------- sign in */\n\n.auth-wrap { max-width: 500px; }\n.auth { padding: 38px 40px 34px; }\n\n.auth-lockup { display: flex; align-items: center; justify-content: center; gap: var(--in-3); margin-bottom: 26px; }\n.auth-mark {\n  display: inline-flex; align-items: center; justify-content: center;\n  width: 52px; height: 52px; border-radius: 14px; flex: none;\n  background: var(--green); box-shadow: 0 8px 26px rgba(34, 233, 72, 0.38);\n}\n.auth-lockup > div { display: flex; flex-direction: column; gap: 5px; }\n.auth-lockup .wordmark { font-size: 27px; }\n.auth-lockup em {\n  font-style: normal; font-size: 10px; font-weight: 700;\n  letter-spacing: 2.6px; text-transform: uppercase; color: var(--accent-ink);\n}\n\n.auth h1 { text-align: center; font-size: 28px; margin: 0 0 26px; letter-spacing: -0.02em; }\n\n/* White pill with the Google mark, as in the reference. */\n.btn-google {\n  display: flex; align-items: center; justify-content: center; gap: var(--in-2);\n  width: 100%; background: #ffffff; color: #1f1f1f;\n  border: 1px solid var(--border); border-radius: 999px;\n  padding: 13px 20px; font-weight: 600; font-size: 15px;\n  transition: background 0.18s ease, transform 0.18s ease;\n}\n.btn-google:hover { background: #f2f2f2; transform: translateY(-1px); }\n\n/* OR with rules running out to both edges. */\n.auth .or {\n  display: flex; align-items: center; gap: var(--sp-4);\n  margin: var(--in-5) 0; color: var(--muted); font-size: 12.5px;\n}\n.auth .or::before, .auth .or::after {\n  content: \"\"; flex: 1; height: 1px; background: var(--border);\n}\n.auth .or span { flex: none; }\n\n.auth label { text-transform: uppercase; letter-spacing: 1.1px; font-size: 11px; font-weight: 700; color: var(--accent-ink); }\n\n.password-wrap { position: relative; }\n.password-wrap input { padding-right: 46px; }\n.reveal {\n  position: absolute; right: 6px; top: 50%; transform: translateY(-50%);\n  background: none; border: 0; color: var(--faint);\n  padding: var(--in-1); border-radius: 8px; display: flex; transition: color 0.18s ease;\n}\n.reveal:hover { color: var(--text); }\n\n.auth-submit { margin-top: var(--in-4); text-transform: uppercase; letter-spacing: 1.4px; font-weight: 700; padding: var(--in-3) 20px; }\n.auth-forgot { display: block; margin: var(--sp-4) auto 0; color: var(--muted); font-weight: 500; font-size: 14px; }\n.auth-forgot:hover { color: var(--green); }\n.auth-demo { margin: var(--in-4) 0 0; }\n\n.auth .check { margin: var(--in-4) 0 0; }\n.auth .check label { text-transform: none; letter-spacing: 0; font-size: 14px; font-weight: 500; color: var(--muted); }\n\n.tabs { display: flex; gap: var(--sp-2); flex-wrap: wrap; margin: var(--sp-4) 0; border-bottom: 1px solid var(--border); padding-bottom: var(--sp-3); }\n.tabs button {\n  background: var(--panel); border: 1px solid var(--border); color: var(--text);\n  border-radius: 999px; padding: var(--sp-2) var(--in-3); font-weight: 600; text-transform: capitalize;\n}\n.tabs button.sel { background: var(--green); color: var(--on-green); font-weight: 800; border-color: transparent; }\n.tabs button .badge {\n  display: inline-block; margin-left: var(--in-1); font-size: 10px; font-weight: 800;\n  background: var(--panel-3); color: var(--muted); border-radius: 999px; padding: 1px var(--in-1);\n}\n\n.dash-grid { display: grid; grid-template-columns: 1fr 330px; gap: var(--in-3); align-items: start; }\n@media (max-width: 900px) { .dash-grid { grid-template-columns: 1fr; } }\n\n.conn {\n  display: flex; align-items: center; gap: var(--sp-3); justify-content: space-between;\n  border-bottom: 1px solid var(--border); padding: var(--sp-3) 0; flex-wrap: wrap;\n}\n.conn:last-child { border-bottom: 0; }\n.conn .who { display: flex; flex-direction: column; }\n.conn .who small { color: var(--muted); }\n.conn button {\n  background: transparent; border: 1px solid var(--green); color: var(--green);\n  border-radius: 999px; padding: var(--in-1) var(--sp-3); font-weight: 600; font-size: 13px;\n}\n\n.profile-card {\n  background: var(--panel); border: 1px solid var(--border);\n  border-radius: 20px; padding: 26px var(--in-5); text-align: center;\n}\n.profile-card h1 { font-size: 26px; margin: var(--sp-3) 0 var(--sp-1); }\n.profile-card .role { color: var(--muted)