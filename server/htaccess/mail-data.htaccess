# Deny all HTTP access to this folder.
#
# The order database and buyer receipt images live here. Nothing in /mail/data
# should ever be reachable from a browser: the API reads it from disk, never
# over HTTP.
#
# Upload to: public_html/mail/data/.htaccess
#
# If the whole site starts returning 403, this file is in the wrong folder.
# It belongs in /mail/data/ only, never in /mail/ itself.

<IfModule mod_authz_core.c>
  Require all denied
</IfModule>

<IfModule !mod_authz_core.c>
  Order deny,allow
  Deny from all
</IfModule>